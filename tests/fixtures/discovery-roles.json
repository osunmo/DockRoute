    {"id": "udp_exposed_port_does_not_explain_tcp_client", "env": {"REDIS_URL": "redis://localhost:6379/private"}, "ports": [{"container": 6379, "protocol": "udp"}], "expected": [["localhost", 6379]]},
    {"id": "udp_published_port_does_not_explain_tcp_client", "env": {"UPSTREAM_URL": "http://localhost:9130"}, "ports": [{"container": 9129, "protocol": "udp", "host": 9130}], "expected": [["localhost", 9130]]}
